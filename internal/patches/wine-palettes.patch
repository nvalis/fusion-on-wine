+/* A contained child has binary visibility, not compositor alpha blending.
+ * Do not promote faint premultiplied edge/shadow pixels to opaque black.
+ * Intersect the original mask so explicit regions and colour keys still win. */
+static Pixmap create_palette_shape_mask( struct x11drv_window_surface *surface, BOOL *changed,
+                                         const BITMAPINFO *shape_info, const void *shape_bits,
+                                         const BITMAPINFO *color_info, const void *color_bits )
+{
+    const BITMAPINFOHEADER *shape = &shape_info->bmiHeader, *color = &color_info->bmiHeader;
+    unsigned int height = abs( color->biHeight ), shape_height = abs( shape->biHeight );
+    unsigned int color_stride = color->biSizeImage / height;
+    unsigned int shape_stride = shape->biSizeImage / shape_height;
+    unsigned int x, y, width = min( color->biWidth, shape->biWidth );
+    struct gdi_image_bits bits = {0};
+    XVisualInfo vis = default_visual;
+    BYTE *mask;
+    Pixmap result;
+
+    if (!(mask = malloc( shape->biSizeImage ))) return None;
+    memcpy( mask, shape_bits, shape->biSizeImage );
+    for (y = 0; y < min( height, shape_height ); y++)
+    {
+        unsigned int color_y = color->biHeight < 0 ? y : height - 1 - y;
+        unsigned int shape_y = shape->biHeight < 0 ? y : shape_height - 1 - y;
+        const UINT32 *pixels = (const UINT32 *)((const BYTE *)color_bits + color_y * color_stride);
+        BYTE *row = mask + shape_y * shape_stride;
+
+        for (x = 0; x < width; x++)
+            if (!(pixels[x] & 0x80000000)) row[x / 8] &= ~(0x80 >> (x % 8));
+    }
+    bits.ptr = mask;
+    vis.depth = 1;
+    result = create_pixmap_from_image( 0, &vis, shape_info, &bits, DIB_RGB_COLORS );
+    if (result && (surface->palette_shape_size != shape->biSizeImage ||
+                   memcmp( surface->palette_shape_bits, mask, shape->biSizeImage )))
+    {
+        *changed = TRUE;
+        free( surface->palette_shape_bits );
+        surface->palette_shape_bits = mask;
+        surface->palette_shape_size = shape->biSizeImage;
+        mask = NULL;
+    }
+    free( mask );
+    return result;
+}
