+/* Keep Win32 popups, but make their X11 surfaces children of the owner. This
+ * leaves placement/stacking with the application while the compositor sees one
+ * toplevel. Do not use the XEMBED path: it deliberately suppresses movement. */
+Window get_fusion_palette_parent( HWND hwnd )
+{
+    static const WCHAR palette_title[] = {'F','u','s','i','o','n','3','6','0',0};
+    static const WCHAR hud_prefix[] = {'H','U','D',':',0};
+    DWORD style = NtUserGetWindowLongW( hwnd, GWL_STYLE ), pid;
+    WCHAR title[128];
+    HWND owner;
+
+    if (!getenv( "FUSION_WINE_EMBED_PALETTES" )) return 0;
+    if ((style & (WS_CHILD | WS_POPUP | WS_CAPTION)) != WS_POPUP) return 0;
+    if (!NtUserInternalGetWindowText( hwnd, title, ARRAY_SIZE(title) )) return 0;
+    if (wcscmp( title, palette_title ) && wcsncmp( title, hud_prefix, 4 )) return 0;
+    if (!(owner = NtUserGetWindowRelative( hwnd, GW_OWNER ))) return 0;
+    owner = NtUserGetAncestor( owner, GA_ROOTOWNER );
+    if (!owner || owner == hwnd || owner == NtUserGetDesktopWindow()) return 0;
+    NtUserGetWindowThread( owner, &pid );
+    if (pid != GetCurrentProcessId()) return 0;
+    return (Window)NtUserGetProp( owner, whole_window_prop );
+}
+
+static void sync_palette_parent( struct x11drv_win_data *data )
+{
+    Window parent = get_fusion_palette_parent( data->hwnd ), child;
+    RECT rect;
+    int x, y;
+
+    if (!data->whole_window || parent == data->palette_parent) return;
+    if (!XTranslateCoordinates( data->display, data->whole_window, parent ? parent : root_window,
+                                0, 0, &x, &y, &child )) return;
+    XReparentWindow( data->display, data->whole_window, parent ? parent : root_window, x, y );
+    data->palette_parent = parent;
+    set_window_parent( data, parent ? parent : root_window );
+    if (data->parent)
+    {
+        rect = data->rects.visible;
+        OffsetRect( &rect, x - rect.left, y - rect.top );
+        host_window_configure_child( data->parent, data->whole_window, rect, FALSE );
+    }
+}
