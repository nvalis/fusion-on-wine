From: Fusion on Wine maintainers
Subject: [PATCH] Synchronize complete offscreen drawables before X11 owner copies

Fusion can leave the visible owner one frame behind its redirected Vulkan
drawable. A present-ID wait and one-pixel X11 readback were insufficient
on a GTX 1060 with NVIDIA 580.178.04 and XWayland. Full-drawable readback
passed repeated real Fusion hover transitions on both NVIDIA and AMD.

Keep this synchronous compatibility path opt-in through
FUSION_WINE_SYNC_PRESENT=1. It has GPU-stall and readback-bandwidth costs,
and is not a general rendering performance improvement. Preserve GDI
clipping, palette handling, and the bounded Vulkan present-ID wait.

--- a/dlls/win32u/vulkan.c
+++ b/dlls/win32u/vulkan.c
@@ -2033,6 +2033,21 @@
         struct surface *surface = swapchain->surface;
         RECT client_rect;
 
+        if (surface->client->offscreen && swapchain_res >= VK_SUCCESS &&
+            getenv( "FUSION_WINE_SYNC_PRESENT" ) &&
+            !strcmp( getenv( "FUSION_WINE_SYNC_PRESENT" ), "1" ))
+        {
+            const VkPresentIdKHR *ids = find_next_struct( present_info->pNext, VK_STRUCTURE_TYPE_PRESENT_ID_KHR );
+            PFN_vkWaitForPresentKHR wait_present = (void *)p_vkGetDeviceProcAddr( device->host.device, "vkWaitForPresentKHR" );
+
+            /* DXVK supplies present IDs when present-wait support is enabled.
+             * Bound the wait and leave presentation errors to the normal path. */
+            if (ids && i < ids->swapchainCount && ids->pPresentIds[i] && wait_present)
+            {
+                VkResult waited = wait_present( device->host.device, swapchains[i], ids->pPresentIds[i], 1000000000 );
+                if (waited != VK_SUCCESS) WARN( "Offscreen present wait returned %d\n", waited );
+            }
+        }
         client_surface_present( surface->client );
 
         if (swapchain_res < VK_SUCCESS) continue;
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -379,6 +379,12 @@
     client_surface_update_offscreen( hwnd, surface );
 }
 
+static int present_readback_error( Display *display, XErrorEvent *event, void *arg )
+{
+    /* The drawable may have resized or disappeared before the X11 request. */
+    return event->error_code == BadMatch || event->error_code == BadDrawable;
+}
+
 static void X11DRV_client_surface_present( struct client_surface *client, HDC hdc )
 {
     struct x11drv_client_surface *surface = impl_from_client_surface( client );
@@ -406,6 +412,25 @@
                          !NtUserGetWindowRelative( toplevel, GW_OWNER ) ? ClipByChildren : IncludeInferiors );
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
+    if (getenv( "FUSION_WINE_SYNC_PRESENT" ) &&
+        !strcmp( getenv( "FUSION_WINE_SYNC_PRESENT" ), "1" ))
+    {
+        int width = rect_src.right - rect_src.left, height = rect_src.bottom - rect_src.top;
+        XImage *image;
+
+        /* A present wait and a one-pixel readback can still leave the owner
+         * one frame behind. Read the complete redirected drawable before the
+         * existing GDI copy. This compatibility path adds GPU readback cost. */
+        if (width > 0 && height > 0)
+        {
+            XSync( gdi_display, False );
+            X11DRV_expect_error( gdi_display, present_readback_error, NULL );
+            image = XGetImage( gdi_display, surface->window, 0, 0, width, height, AllPlanes, ZPixmap );
+            X11DRV_check_error();
+            if (image) XDestroyImage( image );
+            else WARN( "Could not synchronize offscreen drawable %lx\n", surface->window );
+        }
+    }
     NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
                      surface->hdc_src, 0, 0, rect_src.right - rect_src.left, rect_src.bottom - rect_src.top, SRCCOPY, 0 );
     XFlush( gdi_display );
