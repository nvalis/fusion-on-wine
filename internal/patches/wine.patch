+/* Window style changes and surface flushes run on different threads.
+ * Cache input masks separately from window data to avoid reversing the
+ * window-data / window-surface lock order. All mask requests use gdi_display. */
+static struct list input_surfaces = LIST_INIT(input_surfaces);
+static pthread_mutex_t input_surfaces_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+#ifdef HAVE_LIBXSHAPE
+static void apply_surface_input_shape( struct x11drv_window_surface *surface )
+{
+    if (surface->input_transparent)
+    {
+        static XRectangle empty_rect;
+        XShapeCombineRectangles( gdi_display, surface->window, ShapeInput, 0, 0,
+                                 &empty_rect, 1, ShapeSet, YXBanded );
+    }
+    else
+        XShapeCombineMask( gdi_display, surface->window, ShapeInput, 0, 0,
+                           surface->alpha_input_shape ? surface->input_mask : None, ShapeSet );
+}
+#endif
+
+BOOL sync_surface_input_shape( Window window, BOOL transparent )
+{
+#ifdef HAVE_LIBXSHAPE
+    struct x11drv_window_surface *surface;
+    BOOL found = FALSE;
+
+    pthread_mutex_lock( &input_surfaces_mutex );
+    LIST_FOR_EACH_ENTRY( surface, &input_surfaces, struct x11drv_window_surface, input_entry )
+    {
+        if (surface->window != window) continue;
+        surface->input_transparent = transparent;
+        if (!found) apply_surface_input_shape( surface );
+        found = TRUE;
+    }
+    if (found) XFlush( gdi_display );
+    pthread_mutex_unlock( &input_surfaces_mutex );
+    return found;
+#endif
+    return FALSE;
+}
